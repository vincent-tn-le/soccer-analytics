# Get a free token at https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=your_token_here

# Paths (defaults work for local runs from repo root)
MATCHPULSE_RAW_DIR=data/raw
MATCHPULSE_WAREHOUSE_PATH=data/warehouse/matchpulse.duckdb
MATCHPULSE_CONFIG_PATH=config/competitions.yaml

# Dagster: set true to use seed data instead of live API
MATCHPULSE_USE_SEED=false
# Optional comma-separated subset, e.g. PL,PD
# MATCHPULSE_COMPETITIONS=PL,PD,SA,BL1,FL1
